<?xml version="1.0" encoding="UTF-8"?>
<!-- Definizione del Capitolo 3: Aula B. Il capitolo riprende nell'aula LA1, dove
     il giocatore ha appena letto l'email: da qui esce liberamente nel cortile e
     si dirige al Polo B per raggiungere l'Aula B. Nel cortile l'addetto alle
     pulizie fa da guardiano: con Carisma >= 2 apre la porta laterale (e dà
     l'indizio), altrimenti resta da forzare. Tutta questa logica condizionale
     vive nelle classi e nella logica di gioco. L'XML monta solo le scene e i
     riferimenti. L'ultima scena e' terminale: il suo completamento conclude la
     campagna (TO BE CONTINUED / onGameCompleted). -->
<capitolo id="capitolo3" titolo="Capitolo 3: L'aula B" scenaIniziale="aula_la1">

    <!-- Scena iniziale: l'aula LA1, ripresa esattamente come si era conclusa il
         capitolo 2 (giocatore davanti al PC, tecnico al suo posto). L'uscita verso
         il cortile non è un elemento visibile: è la porta in basso a destra, a cui
         ci si avvicina per tornare nel cortile con E. -->
    <scena id="aula_la1" titolo="Aula LA1"
           descrizione="Sei ancora nel laboratorio LA1. Hai letto abbastanza: è ora di muoversi.">
        <npc ref="tecnico_laboratorio"/>
        <transizione etichetta="Esci nel cortile" destinazione="cortile"/>
    </scena>

    <scena id="cortile" titolo="Cortile del Polo di Informatica"
           descrizione="Torni nel cortile del Polo di Informatica. Da una parte l'aula LA1, dall'altra il Polo B con l'Aula B.">
        <!-- Addetto alle pulizie accanto al Polo B: con Carisma alto apre la porta
             laterale e dà l'indizio; posizione fissa gestita dalla vista. -->
        <npc ref="addetto_pulizie"/>
        <transizione etichetta="Rientra in Aula LA1" destinazione="aula_la1"/>
        <transizione etichetta="Entra nell'Aula B" destinazione="aula_b"/>
    </scena>

    <!-- Aula B esplorabile al buio (effetto torcia): si trovano gli indizi
         (orologio inciso per Investigazione, tessuto strappato per Intuizione) o si
         perquisisce l'aula. Non è terminale: trovare un indizio porta all'epilogo,
         così entrare nella stanza non chiude subito la campagna. La transizione
         all'epilogo non è un'uscita visibile (la innesca la logica di gioco). -->
    <scena id="aula_b" titolo="Aula B"
           descrizione="Sei dentro l'Aula B, al buio. Da qualche parte ci sono le tracce dell'incontro: un orologio rotto, un lembo di tessuto strappato...">
        <transizione etichetta="(prosegui)" destinazione="epilogo"/>
    </scena>

    <!-- Scena terminale della campagna: raggiunta trovando l'indizio nell'Aula B.
         Il suo completamento conclude la campagna (TO BE CONTINUED / onGameCompleted). -->
    <scena id="epilogo" titolo="Aula B"
           descrizione="Hai trovato quello che cercavi. Ora devi solo sparire prima che arrivi la polizia.">
    </scena>

</capitolo>
